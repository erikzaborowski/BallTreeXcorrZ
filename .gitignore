*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

# Local checkouts from the separate DR2 implementation
/.worktrees/

# Run logs and generated pipeline products (keep source and job scripts visible)
*.log
*.out
*.err
*.pid
/inputs/
/correlations/
/plots/
/integrated/
/*-d1tree.p
/*-r1tree.p
/*_pix_list.p
