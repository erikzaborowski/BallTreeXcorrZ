# Historical scratch patch; its changes are already in the tracked source.
/python311-compatibility.patch

# Local planning and diagnostics from the larger DR2 investigation.
# Keep directories traversable so its shell/Slurm scripts remain untracked,
# not ignored. The minimal pipeline documentation lives in the root READMEs.
/docs/**
!/docs/**/
!/docs/**/*.sh
!/docs/**/*.slurm
!/docs/**/*.sbatch
